{
  "uid": "gw-operations",
  "title": "LLM Gateway / Operations",
  "description": "Is the gateway healthy, and are providers behaving? The on-call view.",
  "editable": true,
  "schemaVersion": 42,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "graphTooltip": 1,
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Provider health",
      "description": "Health of each provider-model pair: -1 unknown, 0 healthy, 1 degraded, 2 down. Split by model because a provider can be quota-exhausted on one model while serving another normally - the case logical model tiers made reachable. A pair reading -1 has been registered but never observed, which is distinct from healthy.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": null,
          "decimals": null,
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "unknown",
                  "index": 0
                },
                "0": {
                  "text": "healthy",
                  "index": 1
                },
                "1": {
                  "text": "degraded",
                  "index": 2
                },
                "2": {
                  "text": "down",
                  "index": 3
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "gateway_provider_health",
          "legendFormat": "{{provider_name}} / {{model}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Circuit breaker",
      "description": "Open means the provider is being skipped entirely, not retried.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": null,
          "decimals": null,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "closed",
                  "index": 0
                },
                "1": {
                  "text": "half-open",
                  "index": 1
                },
                "2": {
                  "text": "open",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "gateway_circuit_breaker_state",
          "legendFormat": "{{provider_name}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Config reloads rejected",
      "description": "Non-zero means the config on disk was refused, so the running policy and the file have diverged.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": null,
          "decimals": null,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(gateway_config_reloads_total{result=\"rejected\"}) or vector(0)",
          "legendFormat": "rejected",
          "refId": "A",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Config in effect since",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso",
          "decimals": null,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "gateway_config_loaded_timestamp_seconds",
          "legendFormat": "loaded",
          "refId": "A",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Provider error rate",
      "description": "Genuine provider failures only. Rate-limit, budget and unknown-model rejections are gateway policy rather than provider faults: they carry provider=\"none\" and are excluded from both the numerator and the denominator.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "axisSoftMin": 0,
            "scaleDistribution": {
              "type": "linear"
            },
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "gradientMode": "none"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(\n  sum(rate(gateway_errors_total{error_type=~\"Provider.*\"}[5m])) by (provider)\n  or\n  0 * sum(rate(gateway_requests_total{provider!=\"none\"}[5m])) by (provider)\n)\n  /\nclamp_min(sum(rate(gateway_requests_total{provider!=\"none\"}[5m])) by (provider), 0.0001)",
          "legendFormat": "{{provider}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Rejections and errors by cause",
      "description": "Every failure class the gateway distinguishes, including the ones it caused deliberately.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "axisSoftMin": 0,
            "scaleDistribution": {
              "type": "linear"
            },
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "gradientMode": "none"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(gateway_errors_total[5m])) by (error_type)",
          "legendFormat": "{{error_type}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Fallback events",
      "description": "Traffic being served by a provider other than the team's first preference.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "axisSoftMin": 0,
            "scaleDistribution": {
              "type": "linear"
            },
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "gradientMode": "none"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(gateway_fallback_triggered_total[5m])) by (from_provider, to_provider)",
          "legendFormat": "{{from_provider}} to {{to_provider}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Request rate by status",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "axisSoftMin": 0,
            "scaleDistribution": {
              "type": "linear"
            },
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "gradientMode": "none"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(gateway_requests_total[5m])) by (status)",
          "legendFormat": "{{status}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ]
    }
  ]
}
