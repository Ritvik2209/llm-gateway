# Environment variables for the LLM API gateway.
# Copy to .env and fill in. .env is gitignored and must never be committed.

# Required only for teams whose provider chain reaches Groq. Teams routed to the
# mock provider work with no credentials at all.
GROQ_API_KEY=

# Ollama runs on the host, not in the Compose stack. The provider defaults to
# http://localhost:11434; docker-compose.yml overrides this with
# http://host.docker.internal:11434 so the container can reach the host.
# OLLAMA_BASE_URL=http://localhost:11434

# Redis connection. docker-compose.yml sets REDIS_HOST=redis for the container;
# these defaults apply when running the gateway outside Compose.
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0

# --- Demo server only (docker-compose.prod.yml; see docs/DEPLOYMENT.md) ----------------
# The two domains Caddy serves and obtains certificates for. Both must point at the server.
# GATEWAY_DOMAIN=api.example.com
# GRAFANA_DOMAIN=grafana.example.com
# Grafana's admin password. Visitors view the dashboards without logging in.
# GRAFANA_ADMIN_PASSWORD=
# How long the demo page's simulated Groq outage lasts. DEMO_MODE itself is switched on by
# docker-compose.prod.yml rather than here, so local runs leave it off.
# DEMO_OUTAGE_SECONDS=60
