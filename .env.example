# Environment variables for the LLM API gateway.
# Copy to .env and fill in. .env is gitignored and must never be committed.

# Required only for teams whose provider chain reaches Groq. Teams routed to the
# mock provider work with no credentials at all.
GROQ_API_KEY=

# Ollama runs on the host, not in the Compose stack. The provider defaults to
# http://localhost:11434; docker-compose.yml overrides this with
# http://host.docker.internal:11434 so the container can reach the host.
# OLLAMA_BASE_URL=http://localhost:11434

# Redis connection. docker-compose.yml sets REDIS_HOST=redis for the container;
# these defaults apply when running the gateway outside Compose.
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
